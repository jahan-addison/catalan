# Cloudflare Turnstile secret key, the server half of the human check. Never
# put it in frontend/.env.local, which is built into the site. Cloudflare's
# test secret 1x0000000000000000000000000000000AA always passes, and
# 2x0000000000000000000000000000000AA always fails. Empty, there is no human
# check
CATALAN_TURNSTILE_SECRET=

# The host ports for the API and the site
# APP_PORT=18081
# SITE_PORT=18082
