# CATALAN_DOMAIN unset -> plain HTTP on :80, for local testing
# CATALAN_DOMAIN=api.example.com -> automatic HTTPS via Let's Encrypt

{
	order rate_limit before reverse_proxy
}

{$CATALAN_DOMAIN::80} {
	encode zstd gzip

	# 413, matching the API spec
	request_body {
		max_size 256KB
	}

	# 429 with Retry-After, per client IP
	rate_limit {
		zone per_ip {
			key {remote_host}
			events 60
			window 1m
		}
	}

	reverse_proxy {$CATALAN_UPSTREAM:catalan:18080}
}
