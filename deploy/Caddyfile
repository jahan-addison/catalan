# CATALAN_DOMAIN unset -> the API on plain HTTP :80, for local testing
# CATALAN_DOMAIN=api.example.com -> automatic HTTPS via Let's Encrypt
# CATALAN_SITE_DOMAIN unset -> the site on plain HTTP :8080, for local testing
# CATALAN_SITE_DOMAIN=example.com -> automatic HTTPS via Let's Encrypt

{
	order rate_limit before reverse_proxy
}

# The API's limits, the same on both sites
(api) {
	# 413, matching the API spec
	request_body {
		max_size 256KB
	}

	# 429 with Retry-After, per client IP: 60 requests a minute, of which at
	# most 10 can create posts
	rate_limit {
		zone per_ip {
			key {remote_host}
			events 60
			window 1m
		}
		zone posts {
			match {
				method POST
			}
			key {remote_host}
			events 10
			window 1m
		}
	}

	reverse_proxy {$CATALAN_UPSTREAM:catalan:18080}
}

{$CATALAN_DOMAIN::80} {
	encode zstd gzip
	import api
}

{$CATALAN_SITE_DOMAIN::8080} {
	encode zstd gzip

	# the API on the site's own origin, so the browser never needs CORS
	handle /v1/* {
		import api
	}

	# link preview tags, included by the template in index.html
	handle /meta/* {
		reverse_proxy {$CATALAN_UPSTREAM:catalan:18080}
	}

	# the frontend, index.html for every page path so shared links open
	# straight to their page
	handle {
		root * /srv/site

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		try_files {path} /index.html
		templates
		file_server
	}
}
