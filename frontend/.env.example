# Copy to .env.local, which is gitignored, and fill in what you use. The
# Docker build reads it too, unless the same --build-arg is given.

# Adobe Fonts kit id for the UI: Neue Haas Grotesk Display and Text, and IBM
# Plex Mono. Add your domains and localhost to the kit. When empty, the system
# fallback fonts apply
VITE_TYPEKIT_ID=

# Where post reports should go. Adds "Report a post" to the footer and "Report" to
# each post. Empty, there are no report links
VITE_CONTACT_EMAIL=

# Cloudflare Turnstile site key, the public half of the human check. The
# server needs the secret half as CATALAN_TURNSTILE_SECRET. Cloudflare's test
# key 1x00000000000000000000AA always passes. Empty, there is no human check
VITE_TURNSTILE_SITE_KEY=

# npm run dev only: the local catalan server the dev server forwards /v1 and
# /meta to, when the dev container already has 18080
# CATALAN_API_TARGET=http://localhost:18090
